# Optional Compose namespace and published endpoint.
HARBOR_COMPOSE_PROJECT=harbor
HARBOR_PUBLISH_HOST=127.0.0.1
HARBOR_HTTP_PORT=8080
HARBOR_LOG_PORT=1514
# Keep these paths relative to docker_harbor/compose, or set absolute host paths.
HARBOR_DATA_DIR=../work/data
HARBOR_CONFIG_DIR=../work/common/config
HARBOR_NETWORK=harbor
