# Hermes local runtime configuration.
#
# Copy this file to docker_hermes/demo/.env, then start the Compose service with:
#   docker compose --env-file docker_hermes/demo/.env -f docker_hermes/demo/docker-compose.yml up -d

TZ=Asia/Shanghai

# Image to run. Build this tag with tool.sh before starting Compose.
# The Compose service uses pull_policy: never and will not pull an image.
HERMES_IMAGE=quay.io/labnow/hermes:latest

# Host-side persistent data directory.
HERMES_DATA_DIR=/data/storage/workspace/hermes

# Dashboard binding.
HERMES_DASHBOARD=true
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119

# Dashboard basic auth for local development.
# Default local password: hermes-local
# Change these values before exposing the dashboard outside localhost.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH='scrypt$16384$8$1$sq3zEc6Hq6PpPvDQ4nfnGA==$1p+cohbnKhqYEobTra7pjjHPgGHZsGwWTwwdoUu7XSo='
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# HERMES_DASHBOARD_BASIC_AUTH_TTL_SECONDS=43200

# Optional model/provider credentials.
# Do not commit real keys.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
